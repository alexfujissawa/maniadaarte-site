---
export interface Produto {
  id: string;
  titulo: string;
  categoria: string;
  preco: string;
  avisoClube: string;
  imagem: string;
  corFundoPastel: string;
  whatsappMsg: string;
}

interface Props {
  produto: Produto;
}

const { produto } = Astro.props;
const whatsappNumber = "817084150288";
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(produto.whatsappMsg)}`;

// Mapeamento legível de categoria
const categoriaLabels: Record<string, string> = {
  rotina: "Rotina & Agendas",
  festas: "Festas & Mimos",
  corporativo: "Corporativo & Negócios",
};
---

<article
  class="group bg-white rounded-3xl p-4 sm:p-5 border border-brand-brown/10 shadow-paper hover:shadow-paper-hover transition-all duration-300 flex flex-col justify-between"
  data-category={produto.categoria}
>
  <div>
    <!-- Caixa com Fundo Pastel e Imagem Flutuante (Estilo Papier) -->
    <div
      class={`relative w-full aspect-square rounded-2xl ${produto.corFundoPastel} p-6 flex items-center justify-center overflow-hidden transition-colors duration-300`}
    >
      <!-- Selo de Categoria dentro do box -->
      <span class="absolute top-3 left-3 bg-white/90 backdrop-blur-sm text-brand-brown text-[10px] uppercase font-bold tracking-widest px-2.5 py-1 rounded-full shadow-sm">
        {categoriaLabels[produto.categoria] || produto.categoria}
      </span>

      <!-- Imagem Flutuante do Produto sem fundo -->
      <img
        src={produto.imagem}
        alt={produto.titulo}
        loading="lazy"
        class="w-full h-full object-contain filter drop-shadow-md group-hover:scale-105 group-hover:-translate-y-1 group-hover:drop-shadow-xl transition-all duration-300"
      />
    </div>

    <!-- Informações do Produto -->
    <div class="mt-5 space-y-2">
      <div class="flex items-center justify-between gap-2">
        <span class="text-xs uppercase tracking-wider text-brand-softBrown font-medium">
          Personalizado sob medida
        </span>
        <span class="text-xs font-semibold text-brand-brown bg-paper-warm px-2 py-0.5 rounded-md">
          {produto.preco}
        </span>
      </div>

      <h3 class="font-serif text-xl sm:text-2xl font-semibold text-brand-brown leading-snug group-hover:text-brand-terracotta transition-colors">
        {produto.titulo}
      </h3>

      <!-- Aviso Elegante do Clube Mania da Arte -->
      <div class="pt-2">
        <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-pastel-rose/70 border border-brand-rose/40 text-brand-brown text-xs font-medium w-full">
          <span class="text-brand-terracotta text-sm">✨</span>
          <span class="truncate">{produto.avisoClube}</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Botão de Ação WhatsApp -->
  <div class="mt-6 pt-4 border-t border-brand-brown/10">
    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="w-full inline-flex items-center justify-center gap-2 px-5 py-3 rounded-full bg-brand-brown text-paper-warm text-sm font-semibold hover:bg-brand-darkBrown active:scale-[0.98] transition-all duration-200 shadow-sm group/btn"
      aria-label={`Pedir ${produto.titulo} pelo WhatsApp`}
    >
      <svg class="w-4 h-4 fill-current text-green-400 group-hover/btn:scale-110 transition-transform" viewBox="0 0 24 24">
        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
      </svg>
      <span>Pedir no WhatsApp</span>
    </a>
  </div>
</article>
