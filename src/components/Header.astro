---
const whatsappNumber = "817084150288";
const whatsappBaseUrl = `https://wa.me/${whatsappNumber}`;
const instagramUrl = "https://instagram.com/mania.daarte";
const squareClubUrl = "https://square.link/u/r7G7mVJC";
---

