      <div class="marquee-content flex items-center gap-8 shrink-0 pr-8" aria-hidden="true">
        <span class="inline-flex items-center gap-2">
          <span class="inline-block w-2 h-2 rounded-full bg-brand-rose animate-pulse"></span>
          <span class="font-semibold text-white">📦 Enviamos para todo o Japão!</span>
        </span>
        <span class="text-brand-rose/60">•</span>
        <span class="inline-flex items-center gap-1.5 font-semibold text-pastel-peach">
          <span>🏷️ 15% OFF + 🎂 1 Topo de Bolo a cada 12 meses para membros do Clube</span>
        </span>
        <span class="text-brand-rose/60">•</span>

        <span class="inline-flex items-center gap-2">
          <span class="inline-block w-2 h-2 rounded-full bg-brand-rose animate-pulse"></span>
          <span class="font-semibold text-white">📦 Enviamos para todo o Japão!</span>
        </span>
        <span class="text-brand-rose/60">•</span>
        <span class="inline-flex items-center gap-1.5 font-semibold text-pastel-peach">
          <span>🏷️ 15% OFF + 🎂 1 Topo de Bolo a cada 12 meses para membros do Clube</span>
        </span>
        <span class="text-brand-rose/60">•</span>

        <span class="inline-flex items-center gap-2">
          <span class="inline-block w-2 h-2 rounded-full bg-brand-rose animate-pulse"></span>
          <span class="font-semibold text-white">📦 Enviamos para todo o Japão!</span>
        </span>
        <span class="text-brand-rose/60">•</span>
        <span class="inline-flex items-center gap-1.5 font-semibold text-pastel-peach">
          <span>🏷️ 15% OFF + 🎂 1 Topo de Bolo a cada 12 meses para membros do Clube</span>
        </span>
        <span class="text-brand-rose/60">•</span>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-24">
      
      <!-- Logo da Marca com Maior Destaque -->
      <a href="/" class="flex items-center gap-3 group py-1.5 shrink-0" aria-label="Mania da Arte Home">
        <div class="relative shrink-0">
          <img 
            src="/images/logo-mania.png" 
            alt="Mania da Arte Logo" 
            class="h-12 w-12 sm:h-14 sm:w-14 rounded-2xl object-cover shadow-sm border border-brand-brown/10 group-hover:scale-105 transition-all duration-300"
          />
        </div>
        <div class="flex flex-col justify-center shrink-0">
          <span class="font-serif text-xl sm:text-2xl lg:text-3xl font-bold tracking-tight text-brand-brown group-hover:text-brand-terracotta transition-colors leading-none mb-1 whitespace-nowrap">
            Mania da Arte
          </span>
          <span class="text-[9px] sm:text-[10px] tracking-[0.22em] uppercase text-brand-softBrown font-semibold whitespace-nowrap">
            Papelaria Personalizada
          </span>
        </div>
      </a>

      <!-- Navegação Desktop -->
      <nav class="hidden lg:flex items-center space-x-4 xl:space-x-6 text-xs xl:text-sm font-medium whitespace-nowrap">
        <a href="/#catalogo" class="text-brand-brown hover:text-brand-terracotta transition-colors">
          Catálogo
        </a>
        <a href="/#clube" class="text-brand-brown hover:text-brand-terracotta transition-colors flex items-center gap-1.5">
          <span>Clube Mania da Arte</span>
          <span class="bg-pastel-rose text-brand-brown text-[10px] font-bold px-1.5 py-0.5 rounded-full border border-brand-rose/40">
            15% OFF
          </span>
        </a>
        <a href="/blog" class="text-brand-brown hover:text-brand-terracotta transition-colors">
          Blog & Dicas
        </a>
        <a href="/#como-funciona" class="text-brand-brown hover:text-brand-terracotta transition-colors">
          Como Funciona
        </a>
      </nav>

      <!-- Ações Diretas & Social -->
      <div class="hidden sm:flex items-center space-x-2 xl:space-x-3 shrink-0 whitespace-nowrap">
        <!-- Instagram -->
        <a
          href={instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden xl:flex p-2 text-brand-softBrown hover:text-brand-terracotta transition-colors rounded-full hover:bg-brand-brown/5"
          title="Siga @mania.daarte no Instagram"
          aria-label="Instagram da Mania da Arte"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
        </a>

        <!-- Botão WhatsApp Direto -->
        <a
          href={`${whatsappBaseUrl}?text=${encodeURIComponent("Olá! Estou no site da Mania da Arte e gostaria de tirar uma dúvida sobre encomendas.")}`}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden 2xl:inline-flex items-center gap-2 text-xs font-semibold px-3 py-2 rounded-full border border-brand-brown/20 text-brand-brown hover:bg-brand-brown hover:text-white transition-all duration-300"
        >
          <svg class="w-4 h-4 fill-current text-green-600" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
          <span>WhatsApp Japão</span>
        </a>

        <!-- Botão Clube Assinatura -->
        <a
          href={squareClubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 sm:px-4 py-2 rounded-full bg-brand-brown text-paper-warm hover:bg-brand-darkBrown shadow-sm hover:shadow transition-all duration-300"
        >
          <span>Assinar Clube</span>
          <span class="text-brand-rose">¥500/mês</span>
        </a>

        <!-- Portal do Membro VIP -->
        <a
          href="/clube/portal"
          class="inline-flex items-center gap-1 text-xs font-semibold px-3 py-2 rounded-full border border-brand-rose/50 bg-pastel-rose/70 text-brand-brown hover:bg-white transition-all shadow-sm"
        >
          <span>✨ Portal VIP</span>
        </a>
      </div>

      <!-- Menu Mobile Hambúrguer -->
      <div class="flex items-center sm:hidden">
        <button
          id="mobile-menu-btn"
          type="button"
          class="p-2 rounded-md text-brand-brown hover:text-brand-terracotta focus:outline-none"
          aria-label="Abrir Menu"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Menu Mobile Desdobrável -->
  <div id="mobile-menu" class="hidden sm:hidden border-t border-brand-brown/10 bg-paper px-4 pt-3 pb-6 space-y-3">
    <a href="/#catalogo" class="block py-2 text-base font-medium text-brand-brown hover:text-brand-terracotta">
      Catálogo Completo
    </a>
    <a href="/#clube" class="block py-2 text-base font-medium text-brand-brown hover:text-brand-terracotta flex items-center justify-between">
      <span>Clube Mania da Arte</span>
      <span class="bg-pastel-rose text-brand-brown text-xs font-bold px-2 py-0.5 rounded-full">15% OFF</span>
    </a>
    <a href="/blog" class="block py-2 text-base font-medium text-brand-brown hover:text-brand-terracotta">
      Blog & Dicas
    </a>
    <a href="/clube/portal" class="block py-2 text-base font-semibold text-brand-terracotta hover:underline flex items-center justify-between">
      <span>Portal do Membro VIP</span>
      <span class="text-xs bg-pastel-rose px-2 py-0.5 rounded-full border border-brand-rose/40">Entrar →</span>
    </a>
    <a href="/#como-funciona" class="block py-2 text-base font-medium text-brand-brown hover:text-brand-terracotta">
      Como Funciona
    </a>
    <div class="pt-4 border-t border-brand-brown/10 flex flex-col gap-2.5">
      <a
        href={squareClubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full text-center py-2.5 rounded-full bg-brand-brown text-paper-warm font-semibold text-sm shadow"
      >
        Entrar no Clube (¥500/mês)
      </a>
      <a
        href={`${whatsappBaseUrl}?text=${encodeURIComponent("Olá! Gostaria de saber mais sobre a Mania da Arte.")}`}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full text-center py-2.5 rounded-full border border-brand-brown/30 text-brand-brown font-semibold text-sm"
      >
        Falar no WhatsApp (+81 70-8415-0288)
      </a>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  menuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  // Fechar menu ao clicar em um link
  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
    });
  });
</script>

<style>
  @keyframes marquee {
    0% {
      transform: translateX(0%);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .marquee-track {
    width: max-content;
    animation: marquee 32s linear infinite;
  }

  .marquee-track:hover {
    animation-play-state: paused;
  }
</style>
