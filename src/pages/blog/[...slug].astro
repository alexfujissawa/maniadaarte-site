---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const categoriaLabels: Record<string, string> = {
  "lembrancinhas": "Lembrancinhas",
  "festas-infantis": "Festas Infantis no Japão",
  "topos-de-bolo": "Topos de Bolo",
  "presentes-afetivos": "Presentes Afetivos",
  "dicas-de-decoracao": "Dicas de Decoração",
  "rotina": "Rotina & Agendas",
  "corporativo": "Empreendedorismo & Meishi",
};

function formatarData(data: Date) {
  return new Intl.DateTimeFormat("pt-BR", {
    day: "numeric",
    month: "long",
    year: "numeric",
  }).format(data);
}

const whatsappNumber = "817022973498";
const whatsappMsg = encodeURIComponent(
  `Olá! Li o artigo "${post.data.titulo}" no blog da Mania da Arte e gostaria de encomendar uma peça!`
);
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${whatsappMsg}`;
---

<Layout
  title={`${post.data.titulo} | Blog Mania da Arte`}
  description={post.data.descricao}
>
  <Header />

  <main class="py-10 sm:py-16 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 flex-grow">
    
    <!-- Breadcrumb -->
    <nav class="mb-8 text-xs text-brand-softBrown/80 flex items-center gap-2">
      <a href="/" class="hover:text-brand-terracotta transition-colors">Início</a>
      <span>/</span>
      <a href="/blog" class="hover:text-brand-terracotta transition-colors">Blog</a>
      <span>/</span>
      <span class="text-brand-brown truncate font-medium">{post.data.titulo}</span>
    </nav>

    <!-- Artigo Principal -->
    <article class="bg-white rounded-3xl p-6 sm:p-12 border border-brand-brown/10 shadow-paper">
      
      <!-- Cabeçalho do Artigo -->
      <header class="space-y-4 pb-8 border-b border-brand-brown/10">
        <div class="flex items-center gap-3">
          <span class="bg-pastel-peach text-brand-brown text-xs uppercase font-bold tracking-wider px-3 py-1 rounded-full border border-brand-rose/30">
            {categoriaLabels[post.data.categoria] || post.data.categoria}
          </span>
          <span class="text-xs text-brand-softBrown">
            {formatarData(post.data.data)}
          </span>
        </div>

        <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-brand-brown leading-tight">
          {post.data.titulo}
        </h1>

        <p class="text-base sm:text-lg text-brand-softBrown leading-relaxed italic">
          {post.data.descricao}
        </p>

        <!-- Imagem de Destaque Flutuante Estilo Papier -->
        <div class={`w-full aspect-[16/9] ${post.data.corFundoPastel} rounded-2xl overflow-hidden my-6 shadow-inner relative flex items-center justify-center`}>
          <img
            src={post.data.imagem}
            alt={post.data.titulo}
            class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
          />
        </div>
      </header>

      <!-- Conteúdo do Post em Markdown Estilizado -->
      <div class="prose-content py-8 text-brand-brown leading-relaxed space-y-6 text-base sm:text-lg">
        <Content />
      </div>

      <!-- Caixa de Chamada para o WhatsApp & Clube -->
      <div class="mt-10 p-6 sm:p-8 rounded-2xl bg-paper-warm border border-brand-rose/40 space-y-4">
        <div class="flex items-center gap-2">
          <span class="text-brand-terracotta text-lg">✨</span>
          <h3 class="font-serif text-xl font-bold text-brand-brown">
            Encomende sua peça personalizada
          </h3>
        </div>
        <p class="text-sm text-brand-softBrown leading-relaxed">
          Produzimos com papéis premium no Japão e enviamos para qualquer província. Se você for membro do <strong>Clube Mania da Arte (¥500/mês)</strong>, ganha <strong>15% de desconto</strong> no seu pedido!
        </p>
        <div class="flex flex-col sm:flex-row gap-3 pt-2">
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-brand-brown text-paper-warm font-semibold text-sm hover:bg-brand-darkBrown transition-colors shadow"
          >
            <span>Pedir no WhatsApp (+81 70-2297-3498)</span>
          </a>
          <a
            href="https://square.link/u/maniadaarte"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center px-6 py-3 rounded-full border border-brand-brown/30 text-brand-brown font-semibold text-sm hover:bg-white transition-colors"
          >
            Assinar Clube (¥500/mês)
          </a>
        </div>
      </div>

      <!-- Tags do Artigo -->
      {post.data.tags.length > 0 && (
        <div class="mt-8 pt-6 border-t border-brand-brown/10 flex flex-wrap items-center gap-2">
          <span class="text-xs text-brand-softBrown font-bold uppercase tracking-wider">Tags:</span>
          {post.data.tags.map((tag: string) => (
            <span class="text-xs bg-paper-warm text-brand-softBrown px-3 py-1 rounded-full border border-brand-brown/10">
              #{tag}
            </span>
          ))}
        </div>
      )}

      <!-- Botão Voltar -->
      <div class="mt-10 pt-6 border-t border-brand-brown/10 flex justify-between items-center">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 text-sm font-semibold text-brand-brown hover:text-brand-terracotta transition-colors"
        >
          <span>← Voltar para todos os artigos</span>
        </a>
      </div>

    </article>
  </main>

  <Footer />
</Layout>

<style is:global>
  .prose-content h2 {
    font-family: "Playfair Display", Georgia, serif;
    font-size: 1.75rem;
    font-weight: 700;
    color: #4A3E40;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .prose-content h3 {
    font-family: "Playfair Display", Georgia, serif;
    font-size: 1.35rem;
    font-weight: 600;
    color: #4A3E40;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }
  .prose-content p {
    color: #6B5E60;
    line-height: 1.8;
    margin-bottom: 1.25rem;
  }
  .prose-content ul {
    list-style-type: disc;
    padding-left: 1.5rem;
    color: #6B5E60;
    margin-bottom: 1.25rem;
    space-y: 0.5rem;
  }
  .prose-content li {
    margin-bottom: 0.5rem;
  }
  .prose-content strong {
    color: #4A3E40;
    font-weight: 700;
  }
  .prose-content hr {
    border-color: rgba(74, 62, 64, 0.12);
    margin: 2rem 0;
  }
  .prose-content img {
    width: 100%;
    max-height: 480px;
    object-fit: cover;
    border-radius: 1.25rem;
    margin: 1.75rem 0;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.08);
    border: 1px solid rgba(74, 62, 64, 0.1);
  }
</style>
